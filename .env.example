# Database Configuration (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cdn_manager
DB_USER=cdn_user
DB_PASSWORD=your_secure_password

# First User Configuration (created on first setup)
FIRST_USER_EMAIL=admin@example.com
FIRST_USER_PASSWORD=change_this_password

# Directory Configurations
UPLOAD_DIR=/var/www/cdn/uploads
CDN_BASE_PATH=/cdn
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,svg,mp4,webm,pdf,zip,tar,gz

# Server Configuration
PORT=7040

# Session Secret
SESSION_SECRET=your_random_session_secret_here

# Git Commit (Auto-populated during deployment)
GIT_COMMIT=latest
